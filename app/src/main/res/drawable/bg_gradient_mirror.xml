<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo normal -->
    <item>
        <color android:color="#F2F5F9" />
    </item>

    <!-- Reflexo (gradiente invertido) -->
    <item>
        <shape>
            <gradient
                android:startColor="#1F1C2C"
                android:centerColor="#928DAB"
                android:endColor="#1F1C2C"
                android:angle="45" />
        </shape>
    </item>
</layer-list>
